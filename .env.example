# ---------------------------------------------------------------------------
# NaijaBasket environment configuration
# Copy to .env and fill in. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# development | testing | production | serverless
# On Vercel this is ignored unless set explicitly: VERCEL=1 auto-selects the
# "serverless" profile (SQLite in /tmp, auto-seeded demo data, no required keys).
FLASK_ENV=development

# --- Database ---------------------------------------------------------------
# Defaults to a local SQLite file when unset.
# Postgres (production): postgresql://user:password@host:5432/naijabasket
DATABASE_URL=

# --- PII encryption (NDPA 2023 / AES-256-GCM) --------------------------------
# 32-byte key as 64 hex characters. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# --- Payments ---------------------------------------------------------------
# Leave blank to run the deterministic sandbox simulator.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- 3PL dispatch (Kwik / Gokada) -------------------------------------------
# Leave blank to run the deterministic sandbox courier.
KWIK_API_KEY=
KWIK_API_BASE=https://api.kwik.delivery
GOKADA_API_KEY=
GOKADA_API_BASE=https://api.gokada.ng

# --- WhatsApp Business delivery (FR-06) --------------------------------------
# Leave the token / phone-number id blank to run the deterministic sandbox BSP,
# which records the recovery send instead of calling Meta. `app_secret` signs
# inbound delivery/read receipts; `verify_token` answers the webhook handshake.
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=abandoned_cart_recovery
WHATSAPP_TEMPLATE_LANG=en

# --- Edge / reverse proxy (production) --------------------------------------
# Number of trusted proxies in front of the app. Cloudflare -> Render is 2, but
# the value that matters is how many hops append X-Forwarded-* headers.
# 0 = local, no proxy. Production defaults to 1.
PROXY_FIX_HOPS=0

# --- Rate limiting ----------------------------------------------------------
RATELIMIT_ENABLED=1
# Blank falls back to per-process memory, which is only accurate with one
# gunicorn worker. Use a shared Redis (Render Key Value, Upstash) in production.
RATELIMIT_STORAGE_URI=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
# Sentry DSN; leaving it blank disables error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Scheduled sweeps (scheduler.py worker only) ----------------------------
# Ignored when using the Render cron jobs in render.yaml.
SLA_INTERVAL_SECONDS=60
RECOVERY_INTERVAL_SECONDS=300

# --- Business rules (override PRD defaults only with user confirmation) -----
MIN_ORDER_VALUE=15000
TARGET_AOV=35000
CONVENIENCE_FEE=300
MERCHANT_SLA_MINUTES=15
TRANSIT_SLA_MINUTES=45
DELIVERY_RADIUS_KM=8
CART_RECOVERY_MINUTES=30
SUBSCRIPTION_PASS_PRICE=5000
